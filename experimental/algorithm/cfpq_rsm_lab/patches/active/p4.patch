+#define S_NO_STATE ((GrB_Index)-1)
+// reusable tuple arrays (both GrB_Index and Boolean value arrays)
+typedef struct
+{
+    GrB_Index *i;
+    GrB_Index *j;
+    bool *x;
+    GrB_Index cap;
+} S_TupleBuf;
+
+static void s_tuples_free(S_TupleBuf *b)
+{
+    LAGraph_Free((void **)&b->i, NULL);
+    LAGraph_Free((void **)&b->j, NULL);
+    LAGraph_Free((void **)&b->x, NULL);
+    b->cap = 0;
+}
+
+static GrB_Info s_tuples_reserve(S_TupleBuf *b, GrB_Index need, char *msg)
+{
+    if (need <= b->cap)
+        return GrB_SUCCESS;
+
+    GrB_Index cap = (b->cap == 0) ? 64 : b->cap;
+    while (cap < need)
+    {
+        if (cap > (GrB_Index)(SIZE_MAX / (8 * sizeof(GrB_Index))))
+        {
+            cap = need;
+            break;
+        }
+        cap *= 2;
+    }
+
+    int st;
+    st = LAGraph_Realloc((void **)&b->i, (size_t)cap, (size_t)b->cap, sizeof(GrB_Index), msg);
+    if (st < 0)
+        return (GrB_Info)st;
+    st = LAGraph_Realloc((void **)&b->j, (size_t)cap, (size_t)b->cap, sizeof(GrB_Index), msg);
+    if (st < 0)
+        return (GrB_Info)st;
+    st = LAGraph_Realloc((void **)&b->x, (size_t)cap, (size_t)b->cap, sizeof(bool), msg);
+    if (st < 0)
+        return (GrB_Info)st;
+
+    b->cap = cap;
+    return GrB_SUCCESS;
+}
+
+// allocation helpers for the setup helper, which has its own cleanup label
+#define S_ALLOC(ptr, nitems, size)                                                                 \
+    {                                                                                              \
+        int _sst = LAGraph_Malloc((void **)&(ptr), (size_t)(nitems), (size_t)(size), NULL);        \
+        if (_sst < 0)                                                                              \
+        {                                                                                          \
+            info = (GrB_Info)_sst;                                                                 \
+            goto cleanup;                                                                          \
+        }                                                                                          \
+    }
+#define S_CALLOC(ptr, nitems, size)                                                                \
+    {                                                                                              \
+        int _sst = LAGraph_Calloc((void **)&(ptr), (size_t)(nitems), (size_t)(size), NULL);        \
+        if (_sst < 0)                                                                              \
+        {                                                                                          \
+            info = (GrB_Info)_sst;                                                                 \
+            goto cleanup;                                                                          \
+        }                                                                                          \
+    }
+#define S_FREE(ptr) LAGraph_Free((void **)&(ptr), NULL)
+
+#define S_TRY(expr)                                                                                \
+    {                                                                                              \
+        GrB_Info _stry = (expr);                                                                   \
+        if (_stry != GrB_SUCCESS)                                                                  \
+        {                                                                                          \
+            info = _stry;                                                                          \
+            goto cleanup;                                                                          \
+        }                                                                                          \
+    }
+
+// C |= delta with the same first-contribution handle swap as s_mul_acc.
+static GrB_Info s_acc_merge(GrB_Matrix *C, GrB_Matrix *delta, bool *acc_empty)
+{
+    GrB_Index n = 0;
+    H_TRY(GrB_Matrix_nvals(&n, *delta));
+    if (n == 0)
+        return GrB_SUCCESS;
+
+    if (*acc_empty)
+    {
+        GrB_Matrix swap = *C;
+        *C = *delta;
+        *delta = swap;
+        *acc_empty = false;
+    }
+    else
+    {
+        H_TRY(GrB_eWiseAdd(*C, GrB_NULL, GrB_NULL, GrB_LOR, *C, *delta, GrB_NULL));
+    }
+
+    H_TRY(GrB_Matrix_clear(*delta));
+    return GrB_SUCCESS;
+}
+
+typedef struct
+{
+    bool fused;         // this return is consumed by its unique terminal
+    GrB_Index term;     // terminal t of q --t--> r
+    GrB_Index dest;     // persistent destination r
+} S_Fuse;
+
+typedef struct
+{
+    GrB_Index d;        // number of distinct return destinations
+    GrB_Index *dest;    // [d] compact destination state D_A[l]
+    S_Fuse *fuse;       // [d] fusion record for a logical continuation
+    GrB_Matrix route;   // Q x d, route[q,l] = R_A[q, dest[l]]
+    GrB_Matrix x;       // d x V*V on entry, d*V x V while in use
+    GrB_Matrix w;       // d*V x V waiting prefixes
+    GrB_Matrix p;       // d*V x V local product scratch
+} S_WaitBox;
+
+static void s_fusion_free(S_WaitBox **boxes, GrB_Index n)
+{
+    if (*boxes == NULL) return;
+    for (GrB_Index a = 0; a < n; ++a) {
+        LAGraph_Free((void **)&(*boxes)[a].dest, NULL);
+        LAGraph_Free((void **)&(*boxes)[a].fuse, NULL);
+    }
+    LAGraph_Free((void **)boxes, NULL);
+}
+// Scatter local rows l*V+u of a d*V x V product to global rows dest[l]*V+u.
+static GrB_Info s_scatter_local(GrB_Matrix local, GrB_Index d, const GrB_Index *dest,
+                                GrB_Index V, GrB_Matrix *gbuild, S_TupleBuf *tup,
+                                GrB_Matrix *acc, bool *acc_empty, char *msg)
+{
+    GrB_Index n = 0;
+    H_TRY(GrB_Matrix_nvals(&n, local));
+    if (n == 0)
+        return GrB_SUCCESS;
+    H_TRY(s_tuples_reserve(tup, n, msg));
+    H_TRY(GrB_Matrix_extractTuples_BOOL(tup->i, tup->j, tup->x, &n, local));
+    for (GrB_Index k = 0; k < n; ++k)
+    {
+        GrB_Index lr = tup->i[k];
+        GrB_Index l = lr / V;
+        GrB_Index u = lr % V;
+        if (l >= d)
+            return GrB_INVALID_INDEX;
+        tup->i[k] = dest[l] * V + u;
+        tup->x[k] = true;
+    }
+    H_TRY(GrB_Matrix_clear(*gbuild));
+    H_TRY(GrB_Matrix_build_BOOL(*gbuild, tup->i, tup->j, tup->x, n, GrB_LOR));
+    return s_acc_merge(acc, gbuild, acc_empty);
+}
+
+
+static GrB_Info s_build_fusion(S_WaitBox *wb, GrB_Index n, GrB_Index Q, GrB_Index num_term,
+                               GrB_Matrix *rsm_term, const GrB_Matrix *graph_term,
+                               GrB_Matrix *rsm_nonterm, const GrB_Index *start_states,
+                               GrB_Vector *final_states, GrB_Index start_nonterm, char *msg)
+{
+    GrB_Info info = GrB_SUCCESS;
+    bool *is_start = NULL;
+    bool *is_final = NULL;
+    bool *term_in = NULL;
+    bool *nonterm_in = NULL;
+    bool *out_is_term = NULL;
+    bool *cand = NULL;
+    GrB_Index *out_count = NULL;
+    GrB_Index *out_term = NULL;
+    GrB_Index *out_r = NULL;
+    S_TupleBuf ttup;
+    S_TupleBuf ftup;
+    memset(&ttup, 0, sizeof(ttup));
+    memset(&ftup, 0, sizeof(ftup));
+
+    S_CALLOC(is_start, Q, sizeof(bool));
+    S_CALLOC(is_final, Q, sizeof(bool));
+    S_CALLOC(term_in, Q, sizeof(bool));
+    S_CALLOC(nonterm_in, Q, sizeof(bool));
+    S_CALLOC(out_is_term, Q, sizeof(bool));
+    S_CALLOC(cand, Q, sizeof(bool));
+    S_CALLOC(out_count, Q, sizeof(GrB_Index));
+    S_CALLOC(out_term, Q, sizeof(GrB_Index));
+    S_CALLOC(out_r, Q, sizeof(GrB_Index));
+    for (GrB_Index q = 0; q < Q; ++q)
+    {
+        out_term[q] = S_NO_STATE;
+        out_r[q] = S_NO_STATE;
+    }
+
+    if (start_states[start_nonterm] < Q)
+        is_start[start_states[start_nonterm]] = true;
+    for (GrB_Index i = 0; i < n; ++i)
+    {
+        if (rsm_nonterm[i] != GrB_NULL && start_states[i] < Q)
+            is_start[start_states[i]] = true;
+    }
+    for (GrB_Index i = 0; i < n; ++i)
+    {
+        if (final_states[i] == GrB_NULL)
+            continue;
+        GrB_Index fn = 0;
+        info = GrB_Vector_nvals(&fn, final_states[i]);
+        if (info != GrB_SUCCESS)
+            goto cleanup;
+        if (fn == 0)
+            continue;
+        S_TRY(s_tuples_reserve(&ftup, fn, msg));
+        GrB_Index nn = fn;
+        info = GrB_Vector_extractTuples_BOOL(ftup.i, ftup.x, &nn, final_states[i]);
+        if (info != GrB_SUCCESS)
+            goto cleanup;
+        for (GrB_Index k = 0; k < nn; ++k)
+            if (ftup.i[k] < Q)
+                is_final[ftup.i[k]] = true;
+    }
+
+    for (GrB_Index t = 0; t < num_term; ++t)
+    {
+        if (rsm_term[t] == GrB_NULL)
+            continue;
+        GrB_Index rn = 0;
+        info = GrB_Matrix_nvals(&rn, rsm_term[t]);
+        if (info != GrB_SUCCESS)
+            goto cleanup;
+        if (rn == 0)
+            continue;
+        S_TRY(s_tuples_reserve(&ttup, rn, msg));
+        GrB_Index nn = rn;
+        info = GrB_Matrix_extractTuples_BOOL(ttup.i, ttup.j, ttup.x, &nn, rsm_term[t]);
+        if (info != GrB_SUCCESS)
+            goto cleanup;
+        for (GrB_Index k = 0; k < nn; ++k)
+        {
+            GrB_Index a = ttup.i[k];
+            GrB_Index b = ttup.j[k];
+            if (out_count[a] == 0)
+            {
+                out_is_term[a] = true;
+                out_term[a] = t;
+                out_r[a] = b;
+            }
+            out_count[a]++;
+            term_in[b] = true;
+        }
+    }
+    for (GrB_Index i = 0; i < n; ++i)
+    {
+        if (rsm_nonterm[i] == GrB_NULL)
+            continue;
+        GrB_Index rn = 0;
+        info = GrB_Matrix_nvals(&rn, rsm_nonterm[i]);
+        if (info != GrB_SUCCESS)
+            goto cleanup;
+        if (rn == 0)
+            continue;
+        S_TRY(s_tuples_reserve(&ttup, rn, msg));
+        GrB_Index nn = rn;
+        info = GrB_Matrix_extractTuples_BOOL(ttup.i, ttup.j, ttup.x, &nn, rsm_nonterm[i]);
+        if (info != GrB_SUCCESS)
+            goto cleanup;
+        for (GrB_Index k = 0; k < nn; ++k)
+        {
+            out_count[ttup.i[k]]++;
+            nonterm_in[ttup.j[k]] = true;
+        }
+    }
+
+    for (GrB_Index q = 0; q < Q; ++q)
+    {
+        if (is_start[q] || is_final[q] || out_count[q] != 1 || !out_is_term[q])
+            continue;
+        if (out_r[q] == q || out_r[q] >= Q || term_in[q] || !nonterm_in[q])
+            continue;
+        GrB_Index t = out_term[q];
+        if (graph_term[t] == GrB_NULL)
+            continue;
+        GrB_Index gn = 0;
+        info = GrB_Matrix_nvals(&gn, graph_term[t]);
+        if (info != GrB_SUCCESS)
+            goto cleanup;
+        if (gn == 0)
+            continue;
+        cand[q] = true;
+    }
+
+    // exclude chains whose destination is also being eliminated
+    bool changed = true;
+    while (changed)
+    {
+        changed = false;
+        for (GrB_Index q = 0; q < Q; ++q)
+        {
+            if (cand[q] && out_r[q] < Q && cand[out_r[q]])
+            {
+                cand[q] = false;
+                changed = true;
+            }
+        }
+    }
+
+    for (GrB_Index i = 0; i < n; ++i)
+    {
+        for (GrB_Index l = 0; l < wb[i].d; ++l)
+        {
+            GrB_Index q = wb[i].dest[l];
+            if (!cand[q])
+                continue;
+            wb[i].fuse[l].fused = true;
+            wb[i].fuse[l].term = out_term[q];
+            wb[i].fuse[l].dest = out_r[q];
+        }
+    }
+
+cleanup:
+    S_FREE(is_start);
+    S_FREE(is_final);
+    S_FREE(term_in);
+    S_FREE(nonterm_in);
+    S_FREE(out_is_term);
+    S_FREE(cand);
+    S_FREE(out_count);
+    S_FREE(out_term);
+    S_FREE(out_r);
+    s_tuples_free(&ttup);
+    s_tuples_free(&ftup);
+    return info;
+}
+
+// Scatter a local product, consuming fused destination blocks through their
+// unique terminal before reaching the persistent destination.
+static GrB_Info s_scatter_fused(GrB_Matrix local, const S_WaitBox *wb, GrB_Index V,
+                                const GrB_Matrix *graph_term, GrB_Matrix bblk, GrB_Matrix bprod,
+                                GrB_Index *block_rows, GrB_Matrix *gbuild, S_TupleBuf *tup,
+                                GrB_Matrix *acc, bool *acc_empty, char *msg)
+{
+    GrB_Index d = wb->d;
+    if (d == 0 || V == 0)
+        return GrB_SUCCESS;
+
+    // ordinary (non-fused) local rows, harvested in one pass
+    GrB_Index n = 0;
+    H_TRY(GrB_Matrix_nvals(&n, local));
+    if (n > 0)
+    {
+        H_TRY(s_tuples_reserve(tup, n, msg));
+        H_TRY(GrB_Matrix_extractTuples_BOOL(tup->i, tup->j, tup->x, &n, local));
+        GrB_Index out = 0;
+        for (GrB_Index k = 0; k < n; ++k)
+        {
+            GrB_Index lr = tup->i[k];
+            GrB_Index l = lr / V;
+            if (l >= d)
+                return GrB_INVALID_INDEX;
+            if (wb->fuse[l].fused)
+                continue;
+            tup->i[out] = wb->dest[l] * V + (lr % V);
+            tup->j[out] = tup->j[k];
+            tup->x[out] = true;
+            out++;
+        }
+        if (out > 0)
+        {
+            H_TRY(GrB_Matrix_clear(*gbuild));
+            H_TRY(GrB_Matrix_build_BOOL(*gbuild, tup->i, tup->j, tup->x, out, GrB_LOR));
+            H_TRY(s_acc_merge(acc, gbuild, acc_empty));
+        }
+    }
+
+    // fused blocks: apply the continuation terminal, then scatter to r
+    for (GrB_Index l = 0; l < d; ++l)
+    {
+        if (!wb->fuse[l].fused)
+            continue;
+        for (GrB_Index u = 0; u < V; ++u)
+            block_rows[u] = l * V + u;
+        H_TRY(GrB_Matrix_extract(bblk, GrB_NULL, GrB_NULL, local, block_rows, V, GrB_ALL, V,
+                                 GrB_NULL));
+        GrB_Index bn = 0;
+        H_TRY(GrB_Matrix_nvals(&bn, bblk));
+        if (bn == 0)
+            continue;
+        H_TRY(GrB_mxm(bprod, GrB_NULL, GrB_NULL, GxB_ANY_PAIR_BOOL, bblk,
+                      graph_term[wb->fuse[l].term], GrB_NULL));
+        H_TRY(s_scatter_local(bprod, 1, &wb->fuse[l].dest, V, gbuild, tup, acc, acc_empty, msg));
+    }
+
+    return GrB_SUCCESS;
+}
