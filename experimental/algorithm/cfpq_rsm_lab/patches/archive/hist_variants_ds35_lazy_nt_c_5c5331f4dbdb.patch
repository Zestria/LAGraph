+// ---------------------------------------------------------------------------
+// Fixed component bag: owned disjoint BOOL components, at most one per
+// binary magnitude rank.  Capacity is fixed at bag creation.
+// ---------------------------------------------------------------------------
+
+typedef struct
+{
+    GrB_Matrix *comp; // live owned components, [0, count)
+    GrB_Index *nnz;   // cached component nnz
+    GrB_Index count;
+    GrB_Index total;  // exact sum of live component nnz
+    GrB_Index cap;
+    GrB_Index nrows;
+    GrB_Index ncols;
+} s_bag;
+
+#define S_BAG_CAP ((GrB_Index) (8 * sizeof(GrB_Index) + 1))
+
+static GrB_Index s_bag_rank(GrB_Index nnz)
+{
+    GrB_Index rank = 0;
+    while (nnz > 1)
+    {
+        nnz >>= 1;
+        rank++;
+    }
+    return rank;
+}
+
+static int s_bag_init(s_bag *bag, GrB_Index nrows, GrB_Index ncols, char *msg)
+{
+    memset(bag, 0, sizeof(*bag));
+    bag->cap = S_BAG_CAP;
+    bag->nrows = nrows;
+    bag->ncols = ncols;
+    int rc = LAGraph_Calloc((void **) &bag->comp, (size_t) bag->cap, sizeof(GrB_Matrix), msg);
+    if (rc != GrB_SUCCESS)
+        return rc;
+    rc = LAGraph_Calloc((void **) &bag->nnz, (size_t) bag->cap, sizeof(GrB_Index), msg);
+    if (rc != GrB_SUCCESS)
+    {
+        LAGraph_Free((void **) &bag->comp, msg);
+        return rc;
+    }
+    return GrB_SUCCESS;
+}
+
+static void s_bag_free(s_bag *bag)
+{
+    if (bag->comp != NULL)
+    {
+        for (GrB_Index k = 0; k < bag->count; ++k)
+            GrB_free(&bag->comp[k]);
+    }
+    LAGraph_Free((void **) &bag->comp, NULL);
+    LAGraph_Free((void **) &bag->nnz, NULL);
+    bag->count = 0;
+    bag->total = 0;
+}
+
+// Take ownership of *carry; on success *carry becomes NULL.  The carry's
+// original nnz is disjoint from every live component.
+static GrB_Info s_bag_append(s_bag *bag, GrB_Matrix *carry, GrB_Index carry_nnz)
+{
+    if (*carry == GrB_NULL || carry_nnz == 0)
+        return GrB_SUCCESS;
+
+    bag->total += carry_nnz;
+    while (true)
+    {
+        GrB_Index rank = s_bag_rank(carry_nnz);
+        GrB_Index slot = bag->count;
+        for (GrB_Index k = 0; k < bag->count; ++k)
+        {
+            if (s_bag_rank(bag->nnz[k]) == rank)
+            {
+                slot = k;
+                break;
+            }
+        }
+        if (slot == bag->count)
+            break;
+
+        H_TRY(GrB_eWiseAdd(*carry, GrB_NULL, GrB_NULL, GrB_LOR, *carry, bag->comp[slot],
+                           GrB_NULL));
+        carry_nnz += bag->nnz[slot];
+        H_TRY(GrB_free(&bag->comp[slot]));
+        for (GrB_Index k = slot; k + 1 < bag->count; ++k)
+        {
+            bag->comp[k] = bag->comp[k + 1];
+            bag->nnz[k] = bag->nnz[k + 1];
+        }
+        bag->count--;
+    }
+
+    if (bag->count >= bag->cap)
+        return GrB_OUT_OF_MEMORY; // impossible with one component per rank
+
+    bag->comp[bag->count] = *carry;
+    bag->nnz[bag->count] = carry_nnz;
+    bag->count++;
+    *carry = GrB_NULL;
+    return GrB_SUCCESS;
+}
+
+// candidate = candidate \ bag; visits the most recently appended components
+// first and refreshes candidate_nnz after each mask.
+static GrB_Info s_bag_subtract(GrB_Matrix candidate, GrB_Index *candidate_nnz,
+                               const s_bag *bag)
+{
+    for (GrB_Index k = bag->count; k > 0; --k)
+    {
+        H_TRY(GrB_apply(candidate, bag->comp[k - 1], GrB_NULL, GrB_IDENTITY_BOOL, candidate,
+                        GrB_DESC_RSC));
+        H_TRY(GrB_Matrix_nvals(candidate_nnz, candidate));
+        if (*candidate_nnz == 0)
+            break;
+    }
+    return GrB_SUCCESS;
+}
+
 #undef H_TRY
 
