+// C |= A * B with the product scratch and both operands in the requested
+// orientation.  B is the selected graph-terminal view; C keeps its baseline
+// orientation.  A and T are restored to their baseline row orientation.
+static GrB_Info s_mul_acc_format(GrB_Matrix C, GrB_Matrix A, GrB_Matrix B, GrB_Matrix T,
+                                 int32_t desired)
+{
+    H_TRY(GrB_Matrix_set_INT32(A, desired, GxB_FORMAT));
+    H_TRY(GrB_Matrix_set_INT32(T, desired, GxB_FORMAT));
+    H_TRY(GrB_Matrix_clear(T));
+    H_TRY(GrB_mxm(T, GrB_NULL, GrB_NULL, GrB_LOR_LAND_SEMIRING_BOOL, A, B, GrB_NULL));
+    H_TRY(GrB_eWiseAdd(C, GrB_NULL, GrB_NULL, GrB_LOR, C, T, GrB_NULL));
+    H_TRY(GrB_Matrix_set_INT32(A, GxB_BY_ROW, GxB_FORMAT));
+    H_TRY(GrB_Matrix_set_INT32(T, GxB_BY_ROW, GxB_FORMAT));
     return GrB_SUCCESS;
 }
 
