+// DS-20: set column storage with hypersparse control.  GxB_Matrix_reshape keeps
+// the storage orientation but resets the sparsity-control hint to automatic, so
+// it is re-applied after every reshape of new_edges below.  W[i] is never
+// reshaped, and in-place updates keep their output matrix's options.
+static GrB_Info s_set_col_hypersparse(GrB_Matrix A)
+{
+    H_TRY(GrB_Matrix_set_INT32(A, GxB_BY_COL, GxB_FORMAT));
+    H_TRY(GrB_Matrix_set_INT32(A, GxB_HYPERSPARSE, GxB_SPARSITY_CONTROL));
+    return GrB_SUCCESS;
+}
+
 #undef H_TRY
 
